{
  "name": "@flaggable/main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:production": "pnpm run build && wrangler deploy --config wrangler.production.jsonc",
    "preview": "pnpm run build && pnpm run start",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply flaggable-dev --local --config wrangler.dev.jsonc",
    "db:migrate:dev": "wrangler d1 migrations apply flaggable-dev --remote --config wrangler.dev.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply flaggable-dev --remote --config wrangler.production.jsonc",
    "cf-typegen": "wrangler types --config wrangler.dev.jsonc --env-interface CloudflareEnv ./worker-configuration.d.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.26.0",
    "@cfworker/json-schema": "4.1.1",
    "@flaggable/contracts": "workspace:*",
    "@flaggable/ui": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@vinext/cloudflare": "1.0.0-beta.5",
    "drizzle-orm": "0.45.2",
    "ky": "2.0.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tw-animate-css": "1.4.0",
    "uuidv7": "1.2.1",
    "vinext": "1.0.0-beta.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
