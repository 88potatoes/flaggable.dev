{
  "name": "@flaggable/main",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:production": "pnpm run build && wrangler deploy --config wrangler.production.jsonc",
    "preview": "pnpm run build && pnpm run start",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flaggable-dev --local --config wrangler.dev.jsonc",
    "db:migrate:dev": "wrangler d1 migrations apply flaggable-dev --remote --config wrangler.dev.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply flaggable-dev --remote --config wrangler.production.jsonc",
    "cf-typegen": "wrangler types --config wrangler.dev.jsonc --env-interface CloudflareEnv ./worker-configuration.d.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.26.0",
    "@flaggable/ui": "workspace:*",
    "@vinext/cloudflare": "1.0.0-beta.5",


    "drizzle-orm": "^0.45.2",


    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "shadcn": "^4.18.0",

    "tw-animate-css": "^1.4.0",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
